# Copie este arquivo para ".env" e preencha com os valores do seu projeto Firebase.
# Nunca commite o arquivo ".env" (ele já está no .gitignore).

# --- Servidor (Firebase Admin SDK) ---
# So necessario em desenvolvimento local. Quando rodando dentro do Google
# Cloud (Cloud Functions/Cloud Run do mesmo projeto Firebase), o servidor
# usa as credenciais automaticas do ambiente e essas 3 variaveis nao
# precisam existir.
# Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a private_key do JSON exatamente como veio, com as quebras de linha como \n
FIREBASE_PRIVATE_KEY=

# --- Client (Firebase Web SDK, valores públicos) ---
# Project Settings > General > Seus apps > Adicionar app Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Servidor (geral) ---
PORT=5000
NODE_ENV=development
