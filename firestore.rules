rules_version = '2';

// Todo o acesso ao Firestore passa pelo backend Express (Firebase Admin SDK),
// que ignora estas regras. O client nunca fala com o Firestore diretamente,
// entao aqui negamos tudo por seguranca (defesa em profundidade).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
