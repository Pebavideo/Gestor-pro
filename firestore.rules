rules_version = '2';

// Sem servidor (plano Spark, sem Cloud Functions): o client fala direto
// com o Firestore, entao TODO o controle de acesso por papel
// (master/gerente/operador) e por loja que antes vivia em
// server/storage.ts agora vive aqui. Isso e a unica linha de defesa -
// qualquer erro aqui e vazamento de dado ou funcionalidade quebrada.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && myProfileExists() ? myProfile().role : null;
    }

    function myStore() {
      return isSignedIn() && myProfileExists() ? myProfile().store : null;
    }

    function isMaster() {
      return isSignedIn() && myRole() == 'master';
    }

    // Conta do desenvolvedor - camada acima do Master, enxerga todos os
    // lojistas cadastrados no sistema (Painel Admin, /admin). Fixo por
    // e-mail direto do token verificado (nao de um campo do Firestore, que
    // seria menos confiavel). Mantido em sincronia manual com
    // SUPER_ADMIN_EMAIL em shared/models/auth.ts.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'jjoserobertorocharocha@gmail.com';
    }

    // Master + Gerente - mesmo conjunto que "requireMasterOrGerente" tinha
    // no servidor (Operador so cria transacao/produto, nunca edita/exclui).
    function isManager() {
      return isSignedIn() && (myRole() == 'master' || myRole() == 'gerente');
    }

    function ownsDoc(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    // Master enxerga todas as lojas; os outros papeis so a propria loja
    // (mesma logica do storeFilter que existia em storage.ts).
    function inMyStore(data) {
      return isMaster() || data.store == myStore();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isMaster() || isSuperAdmin());
      // Listagem de todos os lojistas: Master (equipe/gerenciamento) ou o
      // Super Admin (Painel /admin, visao do sistema inteiro).
      allow list: if isMaster() || isSuperAdmin();
      // Bootstrap do primeiro login (Google Sign-In cria o proprio perfil).
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Cada um edita o proprio perfil (nome, CNPJ, empresa, foto), mas
      // nunca o proprio role/store - so quem ja e master pode mudar
      // role/store de qualquer usuario (inclusive o proprio).
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.store == resource.data.store)
        || isMaster()
      );
      allow delete: if false;
    }

    match /settings/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Leitura auto-cria um doc padrao (taxRate "15") se nao existir
      // ainda, igual ao comportamento antigo do servidor - qualquer papel
      // pode disparar essa criacao lazy, mas so master edita de fato.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isMaster();
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow get, list: if ownsDoc(resource.data) && inMyStore(resource.data);
      // Qualquer papel autenticado cria transacao (Operador inclusive).
      allow create: if ownsDoc(request.resource.data) && inMyStore(request.resource.data);
      // Editar/excluir (inclui marcar pago, conciliar) e so Master/Gerente.
      allow update: if ownsDoc(resource.data) && isManager() && inMyStore(resource.data)
        && request.resource.data.userId == resource.data.userId
        && inMyStore(request.resource.data);
      allow delete: if ownsDoc(resource.data) && isManager() && inMyStore(resource.data);
    }

    match /employees/{empId} {
      allow get, list: if ownsDoc(resource.data) && inMyStore(resource.data);
      // Cadastrar funcionario e so Master/Gerente.
      allow create: if ownsDoc(request.resource.data) && isManager() && inMyStore(request.resource.data);
      // Editar (inclui desativar via active=0) e so Master/Gerente.
      allow update: if ownsDoc(resource.data) && isManager() && inMyStore(resource.data)
        && request.resource.data.userId == resource.data.userId
        && inMyStore(request.resource.data);
      allow delete: if false;
    }

    match /products/{prodId} {
      allow get, list: if ownsDoc(resource.data) && inMyStore(resource.data);
      // Cadastrar produto e aberto a qualquer papel (igual ao servidor).
      allow create: if ownsDoc(request.resource.data) && inMyStore(request.resource.data);
      // Update cobre tanto a edicao completa (Master/Gerente, controlado
      // na UI) quanto a baixa de estoque atomica ao registrar uma venda
      // (Operador tambem precisa disso) - o dono do doc/loja sempre pode
      // escrever, sem distinguir por papel aqui.
      allow update: if ownsDoc(resource.data) && inMyStore(resource.data)
        && request.resource.data.userId == resource.data.userId
        && inMyStore(request.resource.data);
      allow delete: if false;
    }
  }
}
